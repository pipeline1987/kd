# Search-only key is safe to expose to the browser.
# InstantSearch also uses it for Algolia Insights (clicks/views) when set.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=konoha_daily

# Admin key — used by `npm run index` and the Analytics API on /intel.
# Needs the analytics ACL (the Admin key has it). Never expose this in the client.
ALGOLIA_ADMIN_KEY=

# Analytics API region from Algolia dashboard → Infrastructure → Analytics: us or de.
ALGOLIA_ANALYTICS_REGION=us

# Optional. Powers the Ask the desk briefing clerk (/desk). Without it, the desk
# still searches the ledger and quotes matching files.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
